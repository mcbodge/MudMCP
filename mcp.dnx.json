{
  "$schema": "https://json.schemastore.org/mcp.json",
  "mcpServers": {
    "mudblazor": {
      "description": "MudBlazor MCP Server (dnx - no install, requires .NET 10 SDK)",
      "command": "dnx",
      "args": [
        "MudDocs@1.0.2",
        "--yes",
        "--",
        "--stdio"
      ],
      "env": {
        "MUDBLAZOR_VERSION": "9.0.0",
        "MudBlazor__Repository__DataPath": "${userHome}/.muddocs"
      }
    }
  }
}
