<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <RootNamespace>MudBlazor.Mcp</RootNamespace>
    <NoWarn>$(NoWarn);NU1902;NU1510</NoWarn>
    <!-- Exclude the cloned MudBlazor repository data folder from compilation -->
    <DefaultItemExcludes>$(DefaultItemExcludes);data\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Pack as a .NET tool so the server can be launched one-off with `dnx MudMCP`.
       The target MudBlazor version is supplied at runtime via the MUDBLAZOR_VERSION
       environment variable (or the version flag passed after the argument separator). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mudmcp</ToolCommandName>
    <PackageId>MudMCP</PackageId>
    <Version>1.0.0</Version>
    <Authors>Mud MCP Contributors</Authors>
    <Description>MCP server that exposes MudBlazor component documentation, parameters, and code examples to AI assistants. Launch one-off with `dnx MudMCP`; set the target MudBlazor version via the MUDBLAZOR_VERSION environment variable (or `--version` after `--`).</Description>
    <PackageTags>mcp;modelcontextprotocol;mudblazor;blazor;ai;dotnet-tool;dnx</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mcbodge/MudMCP.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/mcbodge/MudMCP</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MudBlazor.Mcp.ServiceDefaults\MudBlazor.Mcp.ServiceDefaults.csproj" />
  </ItemGroup>

  <!-- Files referenced by PackageLicenseFile / PackageReadmeFile must be packed into the package root. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
