<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>preview</LangVersion>
    <RootNamespace>MudDocs</RootNamespace>
    <NoWarn>$(NoWarn);NU1902;NU1510</NoWarn>
    <!-- Exclude the cloned MudBlazor repository data folder from compilation -->
    <DefaultItemExcludes>$(DefaultItemExcludes);data\**\*</DefaultItemExcludes>
  </PropertyGroup>

  <!-- Pack as a .NET tool so the server can be launched one-off with `dnx MudDocs`.
       The target MudBlazor version is supplied at runtime via the MUDBLAZOR_VERSION
       environment variable (or the version flag passed after the argument separator). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>muddocs</ToolCommandName>
    <PackageId>MudDocs</PackageId>
    <Version>1.0.2</Version>
    <Authors>MudDocs Contributors</Authors>
    <Description>Token-efficient CLI and documentation agent skill exposing version-accurate MudBlazor component documentation (parameters, events, methods, enums, examples) to AI assistants. CLI: dotnet tool install -g MudDocs, then muddocs --help.</Description>
    <PackageTags>mudblazor;blazor;ai;dotnet-tool;dnx;cli;docs</PackageTags>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/mcbodge/MudDocs.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/mcbodge/MudDocs</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="LibGit2Sharp" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MudDocs.ServiceDefaults\MudDocs.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MudDocs.Tests" />
  </ItemGroup>

  <!-- Files referenced by PackageLicenseFile / PackageReadmeFile must be packed into the package root. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
